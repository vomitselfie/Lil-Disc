# Maintainer: Vomitselfie <317440260+vomitselfie@users.noreply.github.com>

pkgname=lildisc
pkgver=2026.09.26.3
pkgrel=1
pkgdesc='Small native Discord client for Linux, in GTK4'
arch=('x86_64' 'aarch64')
url='https://github.com/vomitselfie/Lil-Disc'
license=('GPL-3.0-or-later')
depends=(
	'glib2'
	'gtk4'
	'libadwaita'
	'gtksourceview5'
	'libspelling'
	'gstreamer'
	'gst-plugins-base'
	'gst-plugins-good'
)
makedepends=('go' 'git')
optdepends=(
	'gst-libav: play most videos and voice messages (AAC, H.264)'
	'gst-plugins-bad: more video formats'
	'mpv: play videos from streaming sites'
	'yt-dlp: resolve streaming-site video links'
	'libsecret: remember your login in the system keyring'
)
provides=('lildisc')
conflicts=('lildisc-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b775fac5f7d66448636236a02bcdbbbe753c77add355c1437148744f561de560')

_srcdir="Lil-Disc-$pkgver"
_appid='io.github.vomitselfie.lildisc'

prepare() {
	cd "$_srcdir"
	export GOPATH="$srcdir/gopath"
	# Without -modcacherw Go makes the module cache read-only, and makepkg
	# cannot clean it up afterwards.
	export GOFLAGS='-modcacherw'
	go mod download
}

build() {
	cd "$_srcdir"
	export GOPATH="$srcdir/gopath"
	export CGO_CPPFLAGS="$CPPFLAGS"
	export CGO_CFLAGS="$CFLAGS"
	export CGO_CXXFLAGS="$CXXFLAGS"
	export CGO_LDFLAGS="$LDFLAGS"
	export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
	go build \
		-ldflags "-linkmode=external -X main.Version=$pkgver" \
		-o lildisc .
}

check() {
	cd "$_srcdir"
	export GOPATH="$srcdir/gopath"
	go test ./...
}

package() {
	cd "$_srcdir"
	install -Dm755 lildisc "$pkgdir/usr/bin/lildisc"
	install -Dm644 "nix/$_appid.desktop" "$pkgdir/usr/share/applications/$_appid.desktop"
	install -Dm644 "nix/$_appid.service" "$pkgdir/usr/share/dbus-1/services/$_appid.service"
	install -Dm644 "$_appid.metainfo.xml" "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
	install -Dm644 "internal/icons/hicolor/scalable/apps/$_appid.svg" \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/$_appid.svg"
	install -Dm644 "internal/icons/symbolic/apps/$_appid-symbolic.svg" \
		"$pkgdir/usr/share/icons/hicolor/symbolic/apps/$_appid-symbolic.svg"
	install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
